@using YetAnotherLeagueStatTracker.Client.Data.Dtos


@foreach (var (id, team) in Participants)
{
    <div class="team-col" id="@(team.First().Win? "Victory": "Defeat")">
        @foreach (var participant in team)
        {
            <GameParticipant Participant="participant" IsProfileOwner="@(participant == ProfileOwner)"/>
        }
    </div>
}

@code {
    [Parameter]
    public required Dictionary<int, List<MatchParticipantDto>> Participants { get; set; }
    [Parameter]
    public required MatchParticipantDto ProfileOwner { get; set; }
}