@using YetAnotherLeagueStatTracker.Data
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page">
    <main>
        <div class="top-row px-4">
            <a class="home-link" href="/">YALST</a>
            <SearchBox/>
            <AuthorizeView>
                <Authorized>
                    <div class="user-link">
                        
                        <a href="/profile/@Username">@Username</a>

                        <a href="Account/Manage/">
                            Account
                        </a>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken/>
                            <input type="hidden" name="ReturnUrl" value="@currentUrl"/>
                            <button type="submit" class="nav-link">
                                <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="user-link">
                        <a href="/account/register">Register</a>
                        <a href="/account/login">Login</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
        <div class="footbar">
            <p>Kitten.rs was created under Riot Games' "Legal Jibber Jabber" policy using assets owned by Riot Games.  Riot Games does not endorse or sponsor this project.</p> 
        </div>
        <div class="footbar-hidden">
            <!-- Hack to ensure there is always enough space for the footer -->
            <p>Kitten.rs was created under Riot Games' "Legal Jibber Jabber" policy using assets owned by Riot Games.  Riot Games does not endorse or sponsor this project.</p> 
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<script src="tooltip.js"></script>
<script src="script1.js"></script>

@code {

    private string? Username { get; set; }
    
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }
    
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        var tmp = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Username = tmp.User.Identity?.Name;
    }

}