@using YetAnotherLeagueStatTracker.Data
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <main>
        <div class="top-row px-4">
            <SearchBox/>
            <AuthorizeView>
                <a class="user-link" href="/account/manage">@Username</a>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
        <div class="footbar">
            <p>Kitten.rs was created under Riot Games' "Legal Jibber Jabber" policy using assets owned by Riot Games.  Riot Games does not endorse or sponsor this project.</p> 
        </div>
        <div class="footbar-hidden">
            <!-- Hack to ensure there is always enough space for the footer -->
            <p>Kitten.rs was created under Riot Games' "Legal Jibber Jabber" policy using assets owned by Riot Games.  Riot Games does not endorse or sponsor this project.</p> 
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    private string? Username { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var tmp = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Username = tmp.User.Identity?.Name;
    }

}