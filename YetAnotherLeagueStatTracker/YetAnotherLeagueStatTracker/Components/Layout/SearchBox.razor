@using YetAnotherLeagueStatTracker.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@rendermode InteractiveServer

<div class="search-box" onload="onLoad()">
    <InputSelect @bind-Value="@Region" TValue="string" id="region">
        <option value="br1">BR1</option>
        <option value="eun1">EUN1</option>
        <option value="euw1" selected="true">EUW1</option>
        <option value="jp1">JP1</option>
        <option value="kr">KR</option>
        <option value="la1">LA1</option>
        <option value="la2">LA2</option>
        <option value="na1">NA1</option>
        <option value="oc1">OC1</option>
        <option value="tr1">TR1</option>
        <option value="ru">RU</option>
        <option value="ph2">PH2</option>
        <option value="sg2">SG2</option>
        <option value="th2">TH2</option>
        <option value="tw2">TW2</option>
        <option value="vn2">VN2</option>
    </InputSelect>
    <InputText @bind-Value="Name" class="vertical-left" placeholder="GameName#Tag" @onkeydown="@Enter"></InputText>
    <button class="btn-primary btn" onclick="@Search">Go</button>
</div>

<script src="script1.js"></script>

@code {
    private ElementReference SelectBox { get; set; }
    private string Name { get; set; } = "";

    private string Region { get; set; } = "euw1";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JsRuntime.InvokeAsync<IJSObjectReference>("loadRegion", "script1.js");
        }
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await Search();
        }
    }
    
    public async Task Search()
    {
        if (!PlatformRouting.IsValid(Region) || string.IsNullOrEmpty(Name)) return;

        var splits = Name.Split("#");
        if (splits.Length != 2)
        {
            NavigationManager.NavigateTo($"/profile/{Name}");
            return;
        };
        var module = await JsRuntime.InvokeAsync<IJSObjectReference>("saveCurrentRegion", "script1.js");
        NavigationManager.NavigateTo($"/profile/{Region}/{splits[0]}-{splits[1]}");
    }
}