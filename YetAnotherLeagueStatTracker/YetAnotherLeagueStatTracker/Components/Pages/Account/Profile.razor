@page "/Profile/{Username}"
@using Microsoft.EntityFrameworkCore
@using YetAnotherLeagueStatTracker.Client.Data.Dtos
@using YetAnotherLeagueStatTracker.Client.Pages
@using YetAnotherLeagueStatTracker.Data

@inject IDbContextFactory<ApplicationDbContext> Factory

@if (Summoners.Length > 0)
{
    <MatchHistoryAggregate Summoners="@Summoners"/>
}

@code {
    [Parameter]
    public required string Username { get; set; }

    private SummonerDto[] Summoners { get; set; } = [];
    
    protected override async Task OnInitializedAsync()
    {
        await using var context = await Factory.CreateDbContextAsync();
        Summoners = context.SummonerAssociations.Include(x => x.Summoner).Where(x => x.User.NormalizedUserName == Username.ToUpperInvariant())
            .Select(x=>x.Summoner.ToDto()).ToArray();
        
        
        StateHasChanged();
    }

}