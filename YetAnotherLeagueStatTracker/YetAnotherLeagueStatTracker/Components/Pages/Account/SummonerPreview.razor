@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using YetAnotherLeagueStatTracker.Components.Pages.Profile
@using YetAnotherLeagueStatTracker.Data
@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<div class="summoner-preview">
    <div class="preview-profile-icon">
        <img src="https://cdn.communitydragon.org/@_version/profile-icon/@Summoner.ProfileIconId"/>
        <p>@Summoner.SummonerLevel</p>
    </div>
    <div class="profile-info">
        <span><h1>@Summoner.GameName</h1><h1 class="lighter">#@Summoner.TagLine</h1></span>
        <div class="rank-container">
            <h1>@_rankString</h1>
            @if (Rank != null)
            {
                <p>@Rank.LeaguePoints LP</p>
            }     
        </div>
        @if (EditMode)
        {
            <button class="btn-danger btn" @onclick="Delete">Delete</button>
        }
    </div>
</div>

@code {
    [Parameter] public required SummonerModel Summoner { get; set; }

    [Parameter] public bool EditMode { get; set; }
    
    private RankedModel? Rank => Summoner.GetRank();
    private string _rankString = "Unranked";
    private string _version;

    private async Task Delete()
    {
        var associationModel = await DbContext.SummonerAssociations.SingleOrDefaultAsync(x => x.Summoner == Summoner);
        if (associationModel == null) return;
        DbContext.SummonerAssociations.Remove(associationModel);
        await DbContext.SaveChangesAsync();
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
    
    protected override void OnInitialized()
    {
        _version = DataDragon.Version;

        if (Rank != null)
        {
            if (Rank.Tier >= Tier.Master)
            {
                _rankString = $"{Rank.Tier}";
            }
            else
            {
                _rankString = $"{Rank.Tier} {Rank.Rank}";
            }
            
            
        }
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        _version = await DataDragon.GetVersion();
        StateHasChanged();
    }
}