@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon


<div class="game-participants-container">
    @if (_doSubteams)
    {
        <Subteam Participants="Participants" ProfileOwner="ProfileOwner"/>
    }
    else
    {
        <Team Participants="Participants" ProfileOwner="ProfileOwner"/>
    }
</div>

@code {
    [Parameter]
    public required Dictionary<int, List<MatchParticipant>> Participants { get; set; }
    [Parameter]
    public required MatchParticipant ProfileOwner { get; set; }

    private bool _doSubteams = false;

    protected override void OnInitialized()
    {
        // Subteams start from 1, default 2 teams start at 100
        _doSubteams = !Participants.ContainsKey(100);
        if (_doSubteams)
        {
            Participants = Participants.OrderBy(x => x.Value.First().SubteamPlacement).ToDictionary();
        }
        StateHasChanged();
    }
}