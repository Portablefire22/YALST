@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon

<div class="match-history-game">
    
    @if (ShowProfileIcon)
    {
        <div class="pfp-container">
            <img src="https://cdn.communitydragon.org/@DataDragon.Version/profile-icon/@Game.ProfileOwner.Summoner.ProfileIconId"/>
        </div>
    }
    
    <div class="match-info">
        <div class="match-quick-info">
            <div class="image-container">
                <img src="@ChampIcon"/>
            </div>
            <p id="@(Game.ProfileOwner.Win ? "victory" : "defeat")">@WinText</p>
        </div>
        <div class="spells">
            <GameSpell SummonerId="Game.ProfileOwner.Summoner1Id"/>
            <GameSpell SummonerId="Game.ProfileOwner.Summoner2Id"/>
            @if (_doAugments)
            {
                <GameAugment Augment="@DataDragon.GetAugment(Game.ProfileOwner.PlayerAugment1)"/>
                <GameAugment Augment="@DataDragon.GetAugment(Game.ProfileOwner.PlayerAugment2)"/>
                <GameAugment Augment="@DataDragon.GetAugment(Game.ProfileOwner.PlayerAugment3)"/>
                <GameAugment Augment="@DataDragon.GetAugment(Game.ProfileOwner.PlayerAugment4)"/>
            }
        </div>
        <div class="match-extra-info">
            <p>@(DataDragon.GetQueueDescription(Game.Match.QueueId) ?? Game.Match.QueueId.ToString())</p>
            <p>@((GameEnd - GameStart).ToString(@"mm\:ss"))</p>
        </div>
    </div>
    <div class="match-kda">
        <p>@Game.ProfileOwner.Kills / @Game.ProfileOwner.Deaths / @Game.ProfileOwner.Assists</p>
        <p><small>KDA: </small>@(Kda.ToString("0.00"))</p>
    </div>

    <div class="match-inventory">
        <div class="match-items">
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item0"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item1"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item2"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item3"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item4"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item5"/>
        </div>
        <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item6"/>
    </div>

    <GameParticipants Participants="Game.ParticipantsByTeam" ProfileOwner="@Game.ProfileOwner"/>

</div>

@code {
    [Parameter]
    public required MatchHistoryAggregate.ProfileMatch Game { get; set; }

    [Parameter] public bool ShowProfileIcon { get; set; } = false;
    
    public string ChampIcon = "";
    
    public DateTimeOffset GameStart { get; set; } 
    public DateTimeOffset GameEnd { get; set; } 
    
    private bool _doAugments = false;
    
    public float Kda
    {
        get
        {
            if (Game.ProfileOwner.Deaths > 0) return (Game.ProfileOwner.Kills + Game.ProfileOwner.Assists) / ((float)Game.ProfileOwner.Deaths);
            return Game.ProfileOwner.Kills + Game.ProfileOwner.Assists;
        }
    }

    private string WinText => @Game.ProfileOwner.Win ? "Victory" : "Defeat";
    
    private string Version { get; set; } = "";

    protected override void OnInitialized()
    {

        GameStart = DateTimeOffset.FromUnixTimeMilliseconds(Game.Match.GameStartTimestamp);
        GameEnd = DateTimeOffset.FromUnixTimeMilliseconds(Game.Match.GameEndTimestamp);
        _doAugments = Game.ProfileOwner.PlayerAugment1 != 0;
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        Version = await DataDragon.GetVersion();
        
        if (Game.ProfileOwner.ChampionId == 141)
        {
            ChampIcon = Game.ProfileOwner.ChampionTransform switch
            {
                0 => $"https://cdn.communitydragon.org/{Version}/champion/{Game.ProfileOwner.ChampionId}/square",
                1 => $"https://raw.communitydragon.org/latest/game/assets/characters/kayn/hud/kayn_slay_square.png",
                2 => $"https://raw.communitydragon.org/latest/game/assets/characters/kayn/hud/kayn_ass_square.png",
            };
        }
        else
        {
            ChampIcon = $"https://cdn.communitydragon.org/{Version}/champion/{Game.ProfileOwner.ChampionId}/square";
        }
        
        StateHasChanged();
    }

}