@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon


@foreach (var (id, participants) in Participants)
{
    <div class="sub-team-col" id="@(DataDragon.GetSubTeamName(id))">
        @foreach (var participant in participants)
        {
            <GameParticipant Participant="participant" IsProfileOwner="@(participant == ProfileOwner)"></GameParticipant>
        }
    </div>
}

@code {
    
    [Parameter]
    public required Dictionary<int, List<MatchParticipant>> Participants { get; set; }
    [Parameter]
    public required MatchParticipant ProfileOwner { get; set; }
}