@page "/Profile/{Region}/{GameName}-{Tag}"
@using Microsoft.EntityFrameworkCore.Query.Internal
@using YetAnotherLeagueStatTracker.Data
@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject RiotClient RiotClient
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext

@if (Summoner != null)
{
    <ProfileInfo ProfileName="@Summoner.GameName" Tagline="@Summoner.TagLine" 
                 SummonerLevel="@Summoner.SummonerLevel" Rank="@Rank" ProfileIcon="@Summoner.ProfileIconId"
                 Puuid="@Summoner.Puuid"
                 LastUpdated="@Summoner.RevisionDate"/>
    <MatchHistoryAggregate Summoners="@([Summoner])" /> 
}

@code {

    [Parameter]
    public required string Region { get; set; }
    [Parameter]
    public required string GameName { get; set; }
    [Parameter]
    public required string Tag { get; set; }

    public RankedModel? Rank { get; set; }
    
    private SummonerModel? Summoner { get; set; } = null;
    

    protected override async Task OnInitializedAsync()
    {
        Summoner = await RiotClient.SummonerModelByRiotId(GameName, Tag, Region);
        if (Summoner == null)
        {
            NavigationManager.NavigateTo("/NotFound");
            return;
        }

        var models = Summoner.RankedModels?.ToArray();
        Rank = models switch
        {
            { Length: >= 2 } => RankedModel.HighestRank(models[0], models[1]),
            { Length: 1 } => models[0],
            _ => Rank
        };
        StateHasChanged();
    }
}
