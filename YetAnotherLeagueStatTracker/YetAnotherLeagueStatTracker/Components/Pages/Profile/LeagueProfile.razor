@page "/Profile/{Region}/{GameName}-{Tag}"
@using Microsoft.EntityFrameworkCore.Query.Internal
@using YetAnotherLeagueStatTracker.Client.Data.Dtos
@using YetAnotherLeagueStatTracker.Client.Pages
@using YetAnotherLeagueStatTracker.Data
@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services.Riot
@inject RiotClient RiotClient
@inject NavigationManager NavigationManager

@if (Summoner != null)
{
    <ProfileInfo ProfileName="@Summoner.GameName" Tagline="@Summoner.TagLine" 
                 SummonerLevel="@Summoner.SummonerLevel" Rank="@Rank" ProfileIcon="@Summoner.ProfileIconId"
                 Puuid="@Summoner.Puuid"
                 LastUpdated="@Summoner.RevisionDate"/>
    if (SummonerDto != null)
    {
        <MatchHistoryAggregate Summoners="@([SummonerDto])"/>
    }
}

@code {

    [Parameter]
    public required string Region { get; set; }
    [Parameter]
    public required string GameName { get; set; }
    [Parameter]
    public required string Tag { get; set; }

    public RankedModel? Rank { get; set; }
    
    private SummonerModel? Summoner { get; set; } = null;
    
    private SummonerDto ? SummonerDto { get; set; } = null;

    private void UpdateCallback(SummonerModel? summoner)
    {
        if (summoner == null)
        {
            NavigationManager.NavigateTo("/NotFound");
            return;
        }

        var models = summoner.RankedModels?.ToArray();
        Rank = models switch
        {
            { Length: >= 2 } => RankedModel.HighestRank(models[0], models[1]),
            { Length: 1 } => models[0],
            _ => Rank
        };
        Summoner = summoner;
    }

    protected override async Task OnInitializedAsync()
    { 
        Summoner = await RiotClient.SummonerModelByRiotId(GameName, Tag, Region);
        SummonerDto = Summoner?.ToDto();
        if (Summoner == null || SummonerDto == null)
        {
            NavigationManager.NavigateTo("/NotFound");
            return;
        }

        var models = Summoner.RankedModels?.ToArray();
        Rank = models switch
        {
            { Length: >= 2 } => RankedModel.HighestRank(models[0], models[1]),
            { Length: 1 } => models[0],
            _ => Rank
        };
        Summoner = Summoner;
        StateHasChanged();
       /*RiotClient.QueueAction(new QueueSummoner(GameName, Tag, Region, UpdateCallback));

       while (true)
       {
           if (Summoner != null)
           {
               StateHasChanged();
               break;
           }
           await Task.Delay(5);
       }*/
    }
}
