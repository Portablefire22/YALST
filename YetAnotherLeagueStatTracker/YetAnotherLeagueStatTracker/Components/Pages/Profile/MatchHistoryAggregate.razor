@using Microsoft.EntityFrameworkCore
@using YetAnotherLeagueStatTracker.Components.Pages.Profile.Game
@using YetAnotherLeagueStatTracker.Data
@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject RiotClient RiotClient
@inject IDbContextFactory<ApplicationDbContext> Factory


<div class="match-history">

    @if (History != null)
    {
        @foreach (var game in History)
        {
            <MatchHistoryGame Game="@game" ShowProfileIcon="@ShowProfileIcon"></MatchHistoryGame>
        }
    }
</div>


@code {
    [Parameter]
    public required SummonerModel[] Summoners { get; set; }

    private bool ShowProfileIcon => Summoners.Length > 1;
    
    private ProfileMatch[]? History { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        var hist = new List<ProfileMatch>();
        await using (var context = await Factory.CreateDbContextAsync())
        {
            foreach (var summoner in Summoners)
            {
                var games = await context.MatchParticipants.Where(x => x.Summoner.Id == summoner.Id).Select(y => y.Match).OrderByDescending(x => x.GameCreation).Select(x => x.MatchId).ToArrayAsync();

                foreach (var id in games)
                {
                    var game = await RiotClient.GetMatchById(id);
                    if (game == null) continue;
                    var tmpParticipants = await context.MatchParticipants.Include(x => x.Summoner).Where(x => x.Match.Id == game.Id).ToArrayAsync();

                    var teams = new Dictionary<int, List<MatchParticipant>>();

                    foreach (var participant in tmpParticipants)
                    {
                        if (participant.PlayerSubteamId == 0)
                        {
                            if (!teams.ContainsKey(participant.TeamId)) teams.Add(participant.TeamId, []);
                            teams[participant.TeamId].Add(participant);
                        }
                        else
                        {
                            if (!teams.ContainsKey(participant.PlayerSubteamId)) teams.Add(participant.PlayerSubteamId, []);
                            teams[participant.PlayerSubteamId].Add(participant);
                        }
                    }

                    var m = new ProfileMatch()
                    {
                        Match = game,
                        ProfileOwner = await context.MatchParticipants.Include(matchParticipant => matchParticipant.Summoner).SingleAsync(x => x.Match.Id == game.Id && x.Summoner.Id == summoner.Id),
                        ParticipantsByTeam = teams
                    };
                    hist.Add(m);
                }

            }
        }

        History = hist.OrderByDescending(x => x.Match.GameCreation).ToArray();
        StateHasChanged();
    }
    
    
    public class ProfileMatch
    {
        public MatchModel Match { get; set; }
        public MatchParticipant ProfileOwner { get; set; }
        public Dictionary<int, List<MatchParticipant>> ParticipantsByTeam { get; set; } = [];
    }

}


