@using YetAnotherLeagueStatTracker.Data
@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon

<div class="match-history-game">
    <div class="match-info">
        <div class="match-quick-info">
            <div class="image-container">
                <img src="https://cdn.communitydragon.org/@Version/champion/@Game.ProfileOwner.ChampionId/square"/>
            </div>
            <p id="@(Game.ProfileOwner.Win? "victory" : "defeat")">@WinText</p>
        </div>
        <div class="match-extra-info">
            <p>@(DataDragon.GetQueueDescription(Game.Match.QueueId) ?? Game.Match.QueueId.ToString())</p>
            <p>@((GameEnd - GameStart).ToString(@"mm\:ss"))</p>
        </div>
    </div>
    <div class="match-kda">
        <p>@Game.ProfileOwner.Kills / @Game.ProfileOwner.Deaths / @Game.ProfileOwner.Assists</p>
        <p><small>KDA: </small>@(Kda.ToString("0.00"))</p>
    </div>
    
    <div class="match-inventory">
        <div class="match-items">
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item0"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item1"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item2"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item3"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item4"/>
            <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item5"/>
        </div>
        <MatchItem Version="@Version" ItemId="@Game.ProfileOwner.Item6"/>
    </div>
</div>

@code {
    [Parameter]
    public required MatchHistory.ProfileMatch Game { get; set; }

    public DateTimeOffset GameStart { get; set; } 
    public DateTimeOffset GameEnd { get; set; } 
    
    public float Kda
    {
        get
        {
            if (Game.ProfileOwner.Deaths > 0) return (Game.ProfileOwner.Kills + Game.ProfileOwner.Assists) / ((float)Game.ProfileOwner.Deaths);
            return Game.ProfileOwner.Kills + Game.ProfileOwner.Assists;
        }
    }

    private string WinText => @Game.ProfileOwner.Win ? "Victory" : "Defeat";
    
    private string Version { get; set; } = "";

    protected override void OnInitialized()
    {
        GameStart = DateTimeOffset.FromUnixTimeMilliseconds(Game.Match.GameStartTimestamp);
        GameEnd = DateTimeOffset.FromUnixTimeMilliseconds(Game.Match.GameEndTimestamp);
    }


    protected override async Task OnInitializedAsync()
    {
        Version = await DataDragon.GetVersion();
        
        
        StateHasChanged();
    }

}