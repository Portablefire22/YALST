@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@inject DataDragon DataDragon

<div class="profile">
    <div class="league-profile-icon">
        <img src="https://cdn.communitydragon.org/@_version/profile-icon/@ProfileIcon"/>
        <p>@SummonerLevel</p>
    </div>
    
    <div class="profile-info">
        <span><h1>@ProfileName</h1><h1 class="lighter">#@Tagline</h1></span>
        <div class="rank-container">
            <h1>@_rankString</h1>
            @if (Rank != null)
            {
                <p>@Rank.LeaguePoints LP</p>
            }     
        </div>
       
        @if (Puuid != null)
        {
            <UpdateProfile Puuid="@Puuid" LastUpdated="@LastUpdated"></UpdateProfile>
        }
    </div>
    

</div>

@code {
    [Parameter] public int ProfileIcon { get; set; } = 0;
    [Parameter] public required string Tagline { get; set; }
    [Parameter]
    public required string ProfileName { get; set; }
    [Parameter]
    public long SummonerLevel { get; set; }
    [Parameter]
    public RankedModel? Rank { get; set; }

    private string _rankString = "Unranked";
    
    [Parameter]
    public string? Puuid { get; set; }
    [Parameter]
    public long LastUpdated { get; set; }
    
    private string _version;

    protected override void OnInitialized()
    {
        _version = DataDragon.Version;

        if (Rank != null)
        {
            if (Rank.Tier >= Tier.Master)
            {
                _rankString = $"{Rank.Tier}";
            }
            else
            {
                _rankString = $"{Rank.Tier} {Rank.Rank}";
            }
            
            
        }
        
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _version = await DataDragon.GetVersion();
        StateHasChanged();
    }

}