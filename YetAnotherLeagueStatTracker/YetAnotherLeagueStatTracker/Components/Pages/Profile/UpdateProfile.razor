@using YetAnotherLeagueStatTracker.Data.LeagueModels
@using YetAnotherLeagueStatTracker.Services
@using YetAnotherLeagueStatTracker.Services.Riot
@using YetAnotherLeagueStatTracker.Services.Riot.Actions
@inject RiotClient RiotClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<div class="update-container">
    @if (Disabled)
    {
        <button class="btn btn-primary" disabled>Update</button>
    }
    else
    {
        <button class="btn btn-primary" onclick="@(async () => await OnUpdate())">Update</button>
    }
    <small>Last Updated: @DateTimeOffset.FromUnixTimeMilliseconds(LastUpdated).LocalDateTime</small>
</div>

@code {
    [Parameter]
    public required string Puuid { get; set; }
    [Parameter]
    public long LastUpdated { get; set; }

    private bool Disabled { get; set; } = true;

    private SummonerModel? Summoner { get; set; } = null;
    
    public void Callback(SummonerModel? summoner)
    {
        Console.WriteLine($"/profile/{summoner?.Region}/{summoner?.GameName}-{summoner?.TagLine}");
        Summoner = summoner;
        Disabled = false;
    }
    
    public async Task OnUpdate()
    {
        Disabled = true;
        /*StateHasChanged();
        var summoner = await RiotClient.UpdateSummonerByPuuid(Puuid);
        if (summoner == null) return;
        */
        RiotClient.QueueAction(new QueueUpdateSummoner(Puuid, Callback));

        while (true)
        {
            if (!Disabled && Summoner != null)
            {
                StateHasChanged();
                //NavigationManager.NavigateTo($"/profile/{Summoner.Region}/{Summoner.GameName}-{Summoner.TagLine}", true);
                break;
            }
            await Task.Delay(5);
        }
    }

    protected override void OnInitialized()
    {
        Disabled = RiotClient.InQueue(Puuid);
        StateHasChanged();
    }
}
